nextflow.enable.dsl=2

process {
  executor = 'slurm'
  errorStrategy = 'finish'
  clusterOptions = '--partition=shared --account=naiss2026-3-90'
  cpus = 4
  memory = 4.GB
  time = 4.h

  withLabel: 'process_bwa_index'              { cpus = 8;   memory = 16.GB;   time = 4.h }
  withLabel: 'process_bwa_mem'                { cpus = 16;  memory = 20.GB;   time = 12.h; maxForks = 500 }
  withLabel: 'process_merge_dedup_bams'       { cpus = 16;  memory = 24.GB;   time = 24.h }
  withLabel: 'process_prepare_reference'      { cpus = 4;   memory = 4.GB;    time = 1.h }
  withLabel: 'process_merge_chrom_bcfs'       { cpus = 8;   memory = 8.GB;    time = 2.h }
  withLabel: 'process_make_consensus'         { cpus = 8;   memory = 8.GB;    time = 2.h }
  withLabel: 'process_deepvariant'            { cpus = 32;  memory = 64.GB;   time = 12.h; errorStrategy = 'retry'; maxRetries = 2 }
  withLabel: 'process_filter_variants'        { cpus = 4;   memory = 4.GB;    time = 2.h }
  withLabel: 'process_bcftools_call'          { cpus = 4;   memory = 8.GB;    time = 12.h }
  withLabel: 'process_gatk_indel_realigner'   { cpus = 4;   memory = 16.GB;   time = 12.h; errorStrategy = 'retry'; maxRetries = 2 }
}

apptainer {
  enabled    = true
  autoMounts = true
}

executor {
  name = 'slurm'
  queueSize = 500
}

workDir = 'work'
resume = true


